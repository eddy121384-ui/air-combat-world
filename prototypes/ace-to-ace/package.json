{
  "name": "ace-to-ace",
  "private": true,
  "type": "module",
  "description": "Skyfront Homeland — Ace to Ace 1v1 arcade air-combat AI lab (browser prototype)",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "aivai": "node tools/aivai.mjs --suite --n 60",
    "test": "npm run test:regression && npm run test:cloud && npm run test:sky",
    "test:regression": "node tools/test-brake-trap.mjs && node tools/test-hud-attitude.mjs && node tools/test-flight-path.mjs && node tools/test-airbrake-throttle.mjs && node tools/test-power-strip.mjs",
    "test:cloud": "node tools/test-cloud-field.mjs",
    "test:cloud-browser": "node tools/cloud-lab-check.mjs",
    "test:cloud-b1": "node tools/test-cloud-b1.mjs",
    "test:cloud-b1-browser": "node tools/cloud-b1-check.mjs --round final",
    "test:sky": "node tools/test-opus-sky.mjs",
    "test:sky-browser": "node tools/sky-capture.mjs --out tools/out/sky/stills --stills && node tools/sky-bench-check.mjs",
    "test:sky-cost": "node tools/sky-cost.mjs --out tools/out/sky/cost.json",
    "test:sky-game": "node tools/browser-check.mjs --scenario fight --query sky=opus --out tools/out/sky/game-fight",
    "sky:videos": "node tools/sky-capture.mjs --out docs/cloud-opus/final --video orbit180,traverse,sidepass,approach,deck --fps 24 --size 960x540 --crf 25"
  }
}
